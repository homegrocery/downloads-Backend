# Home Grocery Backend Configuration (घरगुती किराणा यादी)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Dedicated SQLite database file path
DB_PATH=./data/homegrocery.db

# Backup storage directory
BACKUP_DIR=./backups

# Security parameters
SESSION_TTL_HOURS=720
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Neon PostgreSQL Connection String (server-side only, git-ignored)
DATABASE_URL=postgresql://neondb_owner:<password>@<ep-hostname>.region.aws.neon.tech/neondb?sslmode=require
